<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- What the listing on a package feed shows. The version is only a fallback: the
       build hands in the real one, read from src/version.txt plus the run number. -->
  <PropertyGroup>
    <Version>2.0.0.0</Version>
    <Authors>mDuckLab</Authors>
    <Company>MDD4All.de</Company>
    <Copyright>(c) 2026 mDuckLab</Copyright>
    <Description>Sample data models for MDD4All.DME, the object graph editor. Each folder is one small model showing a single thing: objects inside objects, lists and arrays, a dictionary with a complex key, read-only properties, data annotations, an enum.</Description>
    <PackageTags>SampleData DataModels ObjectGraph DataAnnotations</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>Nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Where the package came from, and what a debugger needs to step into this code from
       a project that only has the package. The repository address is not written out: it is
       read from the git remote while packing, so moving the repository changes nothing here. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
